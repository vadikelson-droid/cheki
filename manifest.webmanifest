{
  "id": "./",
  "name": "Чек на стол",
  "short_name": "Чек",
  "description": "Чеки, траты, цены, закупка и рецепты",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffd91a",
  "theme_color": "#ffd91a",
  "icons": [
    { "src": "icons/192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/mask.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [{ "name": "Закупка", "url": "./?tab=buy", "icons": [{ "src": "icons/192.png", "sizes": "192x192" }] }],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["image/*", "application/pdf", ".pdf"] }] }
  }
}
